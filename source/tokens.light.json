{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "background": {
      "canvas": {
        "$value": "{color.neutral.50}",
        "$type": "color"
      },
      "surface": {
        "$value": "{color.neutral.0}",
        "$type": "color"
      },
      "surfaceMuted": {
        "$value": "{color.neutral.100}",
        "$type": "color"
      },
      "surfaceInverse": {
        "$value": "{color.neutral.950}",
        "$type": "color"
      },
      "surfaceBrand": {
        "$value": "{color.brand.primary}",
        "$type": "color"
      },
      "surfaceBrandMuted": {
        "$value": "{color.brand.primaryLight}",
        "$type": "color"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.neutral.900}",
        "$type": "color"
      },
      "secondary": {
        "$value": "{color.neutral.500}",
        "$type": "color"
      },
      "muted": {
        "$value": "{color.neutral.400}",
        "$type": "color"
      },
      "inverse": {
        "$value": "{color.neutral.0}",
        "$type": "color"
      },
      "brand": {
        "$value": "{color.brand.primary}",
        "$type": "color"
      },
      "success": {
        "$value": "{color.success.700}",
        "$type": "color"
      }
    },
    "border": {
      "default": {
        "$value": "{color.neutral.200}",
        "$type": "color"
      },
      "muted": {
        "$value": "{color.neutral.100}",
        "$type": "color"
      },
      "focus": {
        "$value": "{color.brand.primary}",
        "$type": "color"
      }
    },
    "action": {
      "primaryBg": {
        "$value": "{color.brand.primary}",
        "$type": "color"
      },
      "primaryHoverBg": {
        "$value": "{color.brand.primaryHover}",
        "$type": "color"
      },
      "primaryText": {
        "$value": "{color.neutral.0}",
        "$type": "color"
      },
      "secondaryBg": {
        "$value": "{color.neutral.100}",
        "$type": "color"
      },
      "secondaryHoverBg": {
        "$value": "{color.neutral.200}",
        "$type": "color"
      },
      "secondaryText": {
        "$value": "{color.neutral.700}",
        "$type": "color"
      },
      "darkBg": {
        "$value": "{color.neutral.950}",
        "$type": "color"
      },
      "darkText": {
        "$value": "{color.neutral.0}",
        "$type": "color"
      }
    },
    "chart": {
      "barPrimary": {
        "$value": "{color.brand.primary}",
        "$type": "color"
      },
      "barNavy": {
        "$value": "{color.brand.navy}",
        "$type": "color"
      },
      "barSky": {
        "$value": "{color.brand.sky}",
        "$type": "color"
      },
      "barDark": {
        "$value": "{color.neutral.950}",
        "$type": "color"
      },
      "barMuted": {
        "$value": "{color.neutral.200}",
        "$type": "color"
      }
    }
  },
  "typography": {
    "display": {
      "fontSize": "{typography.fontSize.36}",
      "fontWeight": "{typography.fontWeight.bold}",
      "lineHeight": "{typography.lineHeight.tight}",
      "letterSpacing": "{typography.letterSpacing.tight}",
      "fontFamily": "{typography.fontFamily.sans}"
    },
    "headingLg": {
      "fontSize": "{typography.fontSize.28}",
      "fontWeight": "{typography.fontWeight.bold}",
      "lineHeight": "{typography.lineHeight.tight}",
      "fontFamily": "{typography.fontFamily.sans}"
    },
    "headingMd": {
      "fontSize": "{typography.fontSize.20}",
      "fontWeight": "{typography.fontWeight.bold}",
      "lineHeight": "{typography.lineHeight.snug}",
      "fontFamily": "{typography.fontFamily.sans}"
    },
    "headingSm": {
      "fontSize": "{typography.fontSize.16}",
      "fontWeight": "{typography.fontWeight.semibold}",
      "lineHeight": "{typography.lineHeight.snug}",
      "fontFamily": "{typography.fontFamily.sans}"
    },
    "bodyLg": {
      "fontSize": "{typography.fontSize.16}",
      "fontWeight": "{typography.fontWeight.regular}",
      "lineHeight": "{typography.lineHeight.normal}",
      "fontFamily": "{typography.fontFamily.sans}"
    },
    "bodyMd": {
      "fontSize": "{typography.fontSize.14}",
      "fontWeight": "{typography.fontWeight.regular}",
      "lineHeight": "{typography.lineHeight.normal}",
      "fontFamily": "{typography.fontFamily.sans}"
    },
    "bodySm": {
      "fontSize": "{typography.fontSize.12}",
      "fontWeight": "{typography.fontWeight.regular}",
      "lineHeight": "{typography.lineHeight.normal}",
      "fontFamily": "{typography.fontFamily.sans}"
    },
    "label": {
      "fontSize": "{typography.fontSize.13}",
      "fontWeight": "{typography.fontWeight.semibold}",
      "lineHeight": "{typography.lineHeight.none}",
      "fontFamily": "{typography.fontFamily.sans}"
    },
    "metric": {
      "fontSize": "{typography.fontSize.32}",
      "fontWeight": "{typography.fontWeight.bold}",
      "lineHeight": "{typography.lineHeight.tight}",
      "fontFamily": "{typography.fontFamily.sans}"
    }
  },
  "component": {
    "card": {
      "radius": "{radius.2xl}",
      "padding": "{spacing.24}",
      "shadow": "{shadow.card}"
    },
    "pillButton": {
      "radius": "{radius.full}",
      "paddingX": "{spacing.16}",
      "paddingY": "{spacing.10}",
      "fontSize": "{typography.fontSize.13}",
      "fontWeight": "{typography.fontWeight.semibold}"
    },
    "iconButton": {
      "radius": "{radius.full}",
      "size": "40px",
      "bg": "{color.neutral.100}",
      "color": "{color.neutral.700}"
    },
    "badge": {
      "radius": "{radius.full}",
      "paddingX": "{spacing.10}",
      "paddingY": "{spacing.4}",
      "fontSize": "{typography.fontSize.11}",
      "fontWeight": "{typography.fontWeight.semibold}"
    }
  }
}